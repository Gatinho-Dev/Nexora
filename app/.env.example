# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# Public URLs. Required when frontend and backend use different hosts.
APP_ORIGIN=                # Frontend URL, e.g. https://nexora.netlify.app
PUBLIC_API_URL=            # Backend URL, e.g. https://nexora-api.onrender.com
ALLOWED_ORIGINS=           # Comma-separated frontend URLs allowed by CORS

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_API_URL=             # Empty for same-origin; backend URL for split hosting
VITE_WS_URL=              # Optional dedicated WebSocket origin

# WebRTC connectivity. Comma-separate multiple STUN URLs.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=            # e.g. turns:turn.example.com:5349
VITE_TURN_USERNAME=       # Prefer short-lived TURN credentials in production
VITE_TURN_CREDENTIAL=
VITE_VOICE_DEBUG=false    # Enables detailed WebRTC state logs

# Recommended for managed TURN: JSON array returned by /api/rtc-config.
# Example: [{"urls":"turns:turn.example.com:5349","username":"...","credential":"..."}]
ICE_SERVERS=

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
NEXORA_OWNER_USER_IDS=    # Numeric Nexora user IDs, comma-separated (recommended for local accounts)
NEXORA_OWNER_UNION_IDS=   # Additional external Union IDs, comma-separated
NEXORA_ADMIN_USER_IDS=    # Numeric user IDs allowed to access the platform admin panel
NEXORA_ADMIN_UNION_IDS=   # External Union IDs allowed to access the platform admin panel

# ── GIFs (KLIPY) ────────────────────────────────────────────────
KLIPY_API_KEY=            # API key from https://partner.klipy.com/api-keys (required for the GIF picker)
KLIPY_CLIENT_KEY=nexora   # Optional app identifier sent to KLIPY

# ── Segurança de conteúdo (OpenRouter — ÚNICO gateway de IA) ───
# Toda a camada de segurança passa pelo OpenRouter.
# NUNCA use API direta da NVIDIA e NUNCA exponha esta chave no frontend.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Nexora
OPENROUTER_SITE_URL=https://nexorachat.cloud

# Modelo principal de classificação de segurança (texto).
OPENROUTER_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free
# Modelo de visão para imagens (o safety model pode não aceitar imagem).
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Modelo do chatbot oficial — separado da segurança.
OPENROUTER_CHAT_MODEL=
OPENROUTER_SAFETY_TIMEOUT_MS=15000

SAFETY_MAX_RETRIES=3

# Feature flags da camada de segurança
SAFETY_AI_ENABLED=true
TEXT_MODERATION_ENABLED=true
IMAGE_MODERATION_ENABLED=true
REPORT_AI_TRIAGE_ENABLED=true
AUTOMATIC_SEVERE_SUSPENSION_ENABLED=true

# Shadow mode: a IA classifica e registra, mas NÃO aplica ações (testes).
SAFETY_SHADOW_MODE=false
# Kill switch inicial (também controlável em runtime pelo painel admin).
SAFETY_KILL_SWITCH=false

SEVERE_STRIKE_LIMIT=3
SEXUAL_MINOR_INITIAL_SUSPENSION_DAYS=3
SAFETY_POLICY_VERSION=2026.08.1
